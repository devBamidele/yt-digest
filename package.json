{
  "name": "yt-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fixtures:collect": "tsx evals/collect-fixtures.ts",
    "eval:select": "tsx evals/eval-select.ts",
    "eval:summaries": "tsx evals/eval-summaries.ts",
    "eval:ai": "tsx evals/eval-ai.ts",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:logs": "wrangler tail --config worker/wrangler.toml",
    "db:migrate": "wrangler d1 execute yt_digest --remote --config worker/wrangler.toml --file worker/schema.sql",
    "digest:users": "tsx src/multi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "fast-xml-parser": "^5.11.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.86.0"
  }
}
