# Copy to .env for local runs and scripts. Never committed.
# GitHub Actions gets the run's keys from repo secrets; the Cloudflare receiver gets its own via
# `npx wrangler secret put NAME --config worker/wrangler.toml`.

# Used by the digest run (GitHub Actions secrets too)
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
EVENTS_URL=            # the receiver's address, e.g. https://yt-digest-bot.<you>.workers.dev
EVENTS_TOKEN=          # key for the receiver's /api

# Used by the receiver (Cloudflare secrets)
TELEGRAM_CHAT_ID=      # the owner's chat
WEBHOOK_SECRET=        # proves updates really come from Telegram
GOOGLE_WEB_CLIENT_ID=  # Google sign-in, "Web application" client
GOOGLE_WEB_CLIENT_SECRET=
GH_DISPATCH_TOKEN=     # fine-grained GitHub token: Actions read & write on this repo
