# Copy to .env and fill in. .env is gitignored; in GitHub Actions these come from repo secrets.
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for `npm run import-subs -- --login` (Google Cloud → Google Auth Platform → Clients → Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
